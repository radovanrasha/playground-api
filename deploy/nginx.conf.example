# /etc/nginx/sites-available/playground-api  →  symlink into sites-enabled/
#
# The API container uses host networking and listens on 127.0.0.1:3007
# (and the VPS's other interfaces — block 3007 in the firewall if you want
# it reachable only through nginx).
#
# server_name below is an EXAMPLE — use the domain your REACT_APP_SERVER_URL
# secret points to.
#
#   1) Put this file at /etc/nginx/sites-available/playground-api
#   2) ln -s /etc/nginx/sites-available/playground-api /etc/nginx/sites-enabled/
#   3) nginx -t && systemctl reload nginx
#   4) certbot --nginx -d api.playground.radovanrasha.com

server {
    listen 80;
    listen [::]:80;

    server_name api.playground.radovanrasha.com;

    location / {
        proxy_pass http://127.0.0.1:3007;

        # Socket.IO needs the WebSocket upgrade headers.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
    }
}
